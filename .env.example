# Every variable is required: the service validates all of them at startup (src/config.ts) and
# exits with a list of anything missing or malformed. There are no defaults.

# ── Server ──────────────────────────────────────────────────────────────────────────────────────
PORT=8787
DATABASE_URL=postgres://sales_rescue:sales_rescue@127.0.0.1:55470/sales_rescue
# Public HTTPS base URL Chord and Paystack call (Railway domain; a tunnel in local dev). No trailing slash.
PUBLIC_BASE_URL=https://sales-rescue.example.com
# Bearer token Chord sends to /mcp (≥ 32 chars: openssl rand -hex 24)
MCP_TOKEN=
# Owner PIN for owner-only tools (4–12 digits, stored hashed)
OWNER_PIN=
WORKER_INTERVAL_MS=15000

# ── Mock courier (served by this same process under /logistics) ──────────────────────────────────
LOGISTICS_BASE_URL=http://127.0.0.1:8787/logistics
# ≥ 16 chars
LOGISTICS_API_KEY=

# ── Paystack (TEST mode only: sk_test_… is enforced) ─────────────────────────────────────────────
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=

# ── Chord ───────────────────────────────────────────────────────────────────────────────────────
CHORD_BASE_URL=https://api.chordhq.xyz
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
# `pnpm chord:setup` writes this to .chord-state.json. Copy it here. `pnpm deploy:railway` sends it to Railway.
CHORD_TEAMMATE_ID=

# ── Tests only ──────────────────────────────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgres://sales_rescue:sales_rescue@127.0.0.1:55470/sales_rescue_test
